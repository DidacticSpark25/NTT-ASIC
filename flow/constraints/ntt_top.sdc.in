# ntt_top.sdc - timing constraints (template: the Makefile fills in the clock period, ns)
set CLK_PERIOD @CLK_PERIOD@

create_clock -name clk -period $CLK_PERIOD [get_ports clk]
set_clock_uncertainty -setup 0.10 [get_clocks clk]
set_clock_uncertainty -hold  0.05 [get_clocks clk]
set_clock_transition 0.05 [get_clocks clk]

set data_in  [remove_from_collection [all_inputs] [get_ports {clk rst_n}]]
set_input_delay  [expr 0.20 * $CLK_PERIOD] -clock clk $data_in
set_output_delay [expr 0.20 * $CLK_PERIOD] -clock clk [all_outputs]

set_driving_cell -lib_cell BUFX2 $data_in
set_load 0.005 [all_outputs]

# asynchronous active-low reset: synchronized externally, not timed here
set_false_path -from [get_ports rst_n]

set_max_transition 0.25 [current_design]
set_max_fanout 32 [current_design]
